:root {
    --bg-main: #0c0f16;
    --bg-card: #141a24;
    --accent: #0fb682;
    --text-main: #ffffff;
    --text-muted: #7e8e9f;
    --border: #222d3d;
}
* { box-sizing: border-box; margin: 0; padding: 0; font-family: sans-serif; }
body { background-color: var(--bg-main); color: var(--text-main); display: flex; justify-content: center; align-items: center; min-height: 100vh; }
.auth-container { background-color: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; width: 100%; max-width: 400px; padding: 32px; box-shadow: 0 12px 30px rgba(0,0,0,0.5); }
.brand-header { text-align: center; margin-bottom: 24px; }
.brand-header h1 { font-size: 24px; color: var(--accent); margin-bottom: 6px; }
.form-panel { display: none; }
.form-panel.active { display: block; }
.input-group { margin-bottom: 16px; }
.input-group label { display: block; font-size: 11px; text-transform: uppercase; margin-bottom: 6px; color: var(--text-muted); }
input, select { width: 100%; background: var(--bg-main); border: 1px solid var(--border); padding: 12px; border-radius: 8px; color: white; outline: none; }
input:focus { border-color: var(--accent); }
.submit-btn { width: 100%; background: var(--accent); color: white; border: none; padding: 12px; border-radius: 8px; font-weight: bold; cursor: pointer; margin-top: 10px; }
.switch-prompt { text-align: center; margin-top: 16px; font-size: 13px; color: var(--text-muted); }
.switch-prompt a { color: var(--accent); text-decoration: none; }
.otp-box-container { display: flex; justify-content: space-between; gap: 10px; margin: 20px 0; }
.otp-input { height: 50px; text-align: center; font-size: 20px; font-weight: bold; }
